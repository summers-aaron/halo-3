 	)
 {
 	s_vertex_out vertex_out;
@@ -44,11 +41,7 @@
 	vertex_out.position= mul(vertex_in.position, View_Projection);
 	vertex_out.world_space= vertex_in.position;
 	vertex_out.world_space/= vertex_out.world_space.w;
