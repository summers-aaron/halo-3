--- hlsl/downsample_4x4_block_bloom.hlsl
+++ hlsl/downsample_4x4_block_bloom.hlsl
@@ -16,17 +16,19 @@
 {
 	float3 color= 0.00000001f;						// hack to keep divide by zero from happening on the nVidia cards
 
+	// port: the Xbox HDR target holds sqrt(color / DARK_COLOR_MULTIPLIER) (g_HDR_render_mode 2, hdr_gamma2): the
+	// retail microcode squares every sample (128 * sample^2), as the xenon branches of the family do
 	float4 sample= tex2D_offset(dark_source_sampler, IN.texcoord, -1, -1);
-	color += sample.rgb;
+	color += sample.rgb * sample.rgb;
 
 	sample= tex2D_offset(dark_source_sampler, IN.texcoord, +1, -1);
-	color += sample.rgb;
+	color += sample.rgb * sample.rgb;
 
 	sample= tex2D_offset(dark_source_sampler, IN.texcoord, -1, +1);
-	color += sample.rgb;
+	color += sample.rgb * sample.rgb;
 
 	sample= tex2D_offset(dark_source_sampler, IN.texcoord, +1, +1);
-	color += sample.rgb;
+	color += sample.rgb * sample.rgb;
 
 	color= color * DARK_COLOR_MULTIPLIER / 4.0f;
 
--- hlsl/final_composite_base.hlsl
+++ hlsl/final_composite_base.hlsl
@@ -39,7 +39,12 @@
 {
 #ifdef pc
 	float4 accum=		sample2D(surface_sampler, texcoord);
-	float4 accum_dark=	sample2D(dark_surface_sampler, texcoord) * DARK_COLOR_MULTIPLIER;
+	float4 accum_dark=	sample2D(dark_surface_sampler, texcoord);
+	if (HDR_gamma2)											// port: the Xbox HDR target is sqrt-encoded
+	{
+		accum_dark.rgb *= accum_dark.rgb;
+	}
+	accum_dark *= DARK_COLOR_MULTIPLIER;
 	float4 combined = accum_dark * step(accum_dark, (1).rrrr);
 	combined = max(accum, combined);
 #else // XENON
