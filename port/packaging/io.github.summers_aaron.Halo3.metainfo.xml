<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.summers_aaron.Halo3</id>
  <name>Halo 3</name>
  <summary>Native 64-bit PC port of Halo 3 (Xbox 360)</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <launchable type="desktop-id">io.github.summers_aaron.Halo3.desktop</launchable>
  <description>
    <p>
      Native 64-bit x86_64 Vulkan 1.3 PC port of Halo 3 (Xbox 360). On first launch,
      a guided setup window lets you select your retail Halo 3 Xbox 360 disc image (.iso)
      or extracted disc folder, automatically extracts game assets and translates retail
      Xenos shaders to Vulkan SPIR-V into your sandboxed user data directory, and launches
      the game.
    </p>
    <p>
      Requires a user-supplied retail Halo 3 Xbox 360 disc image and a Vulkan 1.3 capable GPU.
    </p>
  </description>
  <categories>
    <category>Game</category>
    <category>ActionGame</category>
    <category>Shooter</category>
  </categories>
  <provides>
    <binary>halo3-launcher</binary>
    <binary>halo3</binary>
  </provides>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="violence-bloodshed">moderate</content_attribute>
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-audio">moderate</content_attribute>
  </content_rating>
</component>
