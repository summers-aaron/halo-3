#include <winresrc.h>

101 ICON "halo3.ico"
1 RT_MANIFEST "halo3.manifest"

#ifndef HALO3_RC_ICON_ONLY

#ifndef HALO3_RC_VER_STR
#define HALO3_RC_VER_STR "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Halo 3 PC Port"
            VALUE "FileDescription", "Halo 3 (Native PC Port)"
            VALUE "FileVersion", HALO3_RC_VER_STR
            VALUE "InternalName", "Halo3"
            VALUE "OriginalFilename", "Halo3.exe"
            VALUE "ProductName", "Halo 3 PC Port"
            VALUE "ProductVersion", HALO3_RC_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif
